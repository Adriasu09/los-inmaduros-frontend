# ==================== APP URL ====================
# Local dev: http://localhost:3000 · Production: your Vercel domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==================== API BACKEND ====================
# FastAPI base URL, must end in /api.
# Local backend: http://localhost:8000/api · Deployed (Render): https://los-inmaduros-fastapi.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ==================== CLERK AUTHENTICATION ====================
# Use the SAME Clerk credentials as the backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
